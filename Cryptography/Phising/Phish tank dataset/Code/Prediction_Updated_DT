# ============================================================
# 4. NORMALIZATION FUNCTION
# ============================================================

def normalize_brand(value):

    return re.sub(
        r"[^a-z0-9]",
        "",
        str(value).lower().strip()
    )


# ============================================================
# 5. URL CLEANING FUNCTION
# ============================================================

# ============================================================
# URL CLEANING FUNCTION
# ============================================================

def clean_url(url):

    if pd.isna(url):
        return ""

    url = str(url).strip().lower()

    # Remove HTTP and HTTPS protocols
    url = re.sub(r"^https?://", "", url)

    # Remove www prefix
    url = re.sub(r"^www\.", "", url)

    # Remove trailing slash(es)
    url = url.rstrip("/")

    return url


# ============================================================
# 6. DOMAIN EXTRACTION
# ============================================================

def extract_domain_parts(url):

    cleaned_url = clean_url(url)

    if not cleaned_url:
        return "", ""

    try:

        parsed = urlparse(
            "http://" + cleaned_url
        )

        hostname = parsed.hostname or ""

        hostname = hostname.lower().strip(".")

        extracted = extractor(hostname)

        domain_name = extracted.domain or ""

        return hostname, domain_name

    except Exception:

        return "", ""


# ============================================================
# 7. BRAND SIMILARITY
# ============================================================

def calculate_brand_similarity(domain_name):

    domain_name = normalize_brand(domain_name)

    if not domain_name:
        return 0.0

    candidates = brand_index.get(
        domain_name[0], []
    )

    if not candidates:
        return 0.0

    result = process.extractOne(
        domain_name,
        candidates,
        scorer=fuzz.ratio,
        score_cutoff=0
    )

    if result is None:
        return 0.0

    best_brand, similarity_score, _ = result

    return similarity_score / 100.0


# ============================================================
# 8. FEATURE EXTRACTION
# ============================================================

def extract_features(url):

    # Clean URL before feature extraction
    raw_url = clean_url(url)

    hostname, domain_name = extract_domain_parts(
        raw_url
    )

    # Parse cleaned URL
    try:

        parsed = urlparse(
            "http://" + raw_url
        )

        path = parsed.path or ""

    except Exception:

        path = ""

    # --------------------------------------------------------
    # Basic URL features
    # --------------------------------------------------------

    url_length = len(raw_url)

    hostname_length = len(hostname)

    dot_count = raw_url.count(".")

    hyphen_count = raw_url.count("-")

    at_count = raw_url.count("@")

    digit_count = sum(
        character.isdigit()
        for character in raw_url
    )

    subdomain_count = (
        max(0, len(hostname.split(".")) - 2)
        if hostname else 0
    )

    path_length = len(path)

    # --------------------------------------------------------
    # Brand features
    # --------------------------------------------------------

    normalized_domain = normalize_brand(
        domain_name
    )

    brand_similarity = calculate_brand_similarity(
        normalized_domain
    )

    exact_brand_match = int(
        normalized_domain in brand_set
        if normalized_domain else False
    )

    candidates = brand_index.get(
        normalized_domain[0], []
    ) if normalized_domain else []

    brand_substring_match = int(
        any(
            len(brand) >= 4 and
            brand in normalized_domain
            for brand in candidates
        )
    )

    # --------------------------------------------------------
    # Return all features
    # --------------------------------------------------------

    return {

        "url_length": url_length,

        "hostname_length": hostname_length,

        "dot_count": dot_count,

        "hyphen_count": hyphen_count,

        "at_count": at_count,

        "digit_count": digit_count,

        "subdomain_count": subdomain_count,

        "path_length": path_length,

        "brand_similarity": brand_similarity,

        "exact_brand_match": exact_brand_match,

        "brand_substring_match": brand_substring_match
    }


# ============================================================
# 9. PREDICT URL
