def predict_url(url):

    # Extract features from cleaned URL
    features = extract_features(url)

    # Convert features into DataFrame
    input_df = pd.DataFrame(
        [features],
        columns=FEATURE_COLUMNS
    )

    # Prediction
    prediction = model.predict(input_df)[0]

    probabilities = model.predict_proba(input_df)[0]

    # Get probabilities using actual class positions
    legitimate_probability = probabilities[
        list(model.classes_).index(0)
    ]

    phishing_probability = probabilities[
        list(model.classes_).index(1)
    ]

    # Extract domain
    hostname, domain_name = extract_domain_parts(url)

    # Output
    print("\n======================================")
    print("          URL ANALYSIS RESULT")
    print("======================================")

    print("\nOriginal URL:")
    print(url)

    print("\nCleaned URL:")
    print(clean_url(url))

    print("\nExtracted Hostname:")
    print(hostname)

    print("\nExtracted Domain:")
    print(domain_name)

    print("\nBrand Similarity:")
    print(
        round(
            features["brand_similarity"] * 100,
            2
        ),
        "%"
    )

    print("\nExact Brand Match:")
    print(
        "Yes" if features["exact_brand_match"] else "No"
    )

    print("\nBrand Substring Match:")
    print(
        "Yes" if features["brand_substring_match"] else "No"
    )

    print("\n--------------------------------------")

    if prediction == 1:

        print("PREDICTION: PHISHING")

    else:

        print("PREDICTION: LEGITIMATE")

    print("--------------------------------------")

    print(
        "Legitimate Probability:",
        round(legitimate_probability * 100, 2),
        "%"
    )

    print(
        "Phishing Probability:",
        round(phishing_probability * 100, 2),
        "%"
    )

    print("======================================")

    return prediction


